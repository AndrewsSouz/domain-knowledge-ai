# Copie para .env e ajuste se quiser. Sem .env, a aplicação e o compose usam
# estes mesmos valores como padrão (ambiente local de desenvolvimento).

# PostgreSQL
POSTGRES_DB=dka
POSTGRES_USER=dka
POSTGRES_PASSWORD=dka

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Storage S3 (RustFS no ambiente local)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=documents
STORAGE_ACCESS_KEY=dka-access
STORAGE_SECRET_KEY=dka-secret-change-me
